# Machine-specific settings for the host "desktop".
# hardware-configuration.nix is generated by YOU on the machine (never by hand):
#   nixos-generate-config --show-hardware-config > hardware-configuration.nix
{ ... }:
{
  imports = [
    ../../configuration.nix
    ../../hardware-configuration.nix
  ];

  networking.hostName = "desktop";

  # TODO: set to the version your installer wrote in its generated configuration.nix
  # (look for `system.stateVersion`). Do NOT change it later just to "upgrade".
  system.stateVersion = "26.05";

  # GPU: the open-source Mesa drivers (Intel/AMD) work with this alone.
  hardware.graphics.enable = true;
  # NVIDIA owners: tell me and I'll add the proper block. Not guessing here.
}
